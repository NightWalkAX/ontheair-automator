<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.glc.ontheair-automator</string>
  <!-- At login, open the auto-restart loop in Terminal (Terminal holds the TCC grants). -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>-a</string>
    <string>Terminal</string>
    <string>/Users/transmission3/Documents/ontheair-automator/scripts/mac/run-automator.command</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
